# SMTP credentials for the contact form (Nodemailer).
# Create a local .env.local from this template and fill in real values,
# or set these in your hosting provider's environment settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Inbox that receives contact-form submissions.
MAIL_TO=zeon.cse@gmail.com